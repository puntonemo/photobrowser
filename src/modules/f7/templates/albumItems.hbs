<!-- rest of component logic -->
<script>
    // script must return/export component function
    export default (props, { $f7, $on, $f7router }) => {
        let pageTitle = props.title ?? "Album Items"

        async function addItem(group, id) {
            const container = document.querySelector(`#ai-grid-${group}`);
            if(container) {
                const attributes = {
                    'id': id,
                }
                return await loadComponent(container, 'album-item', attributes);
            }
            return undefined;
        }
        async function addGroup(id, title) {
            const container = document.querySelector('#ai-container');
            if(container) {
                const attributes = {
                    'id': id,
                    'title': title,
                }
                return await loadComponent(container, 'album-items-container', attributes);
            }
            return undefined;
        }
        
        async function getAlbumItems(id) {
            $f7.dialog.preloader();
            const res = await fetch(`/api/pb/albums/${id}/items`);
            if (res.ok) {
                const response = await res.json();
                console.log(response);
                for (const item of response.data) {
                    const group = `${item.momentYear}${item.momentMonth}`;
                    const title = `${item.momentMonth}-${item.momentYear}`;

                    let groupEl = document.querySelector(`#ai-grid-${group}`);
                    if(!groupEl) 
                        groupEl = await addGroup(group, title);
                    

                    await addItem(group, item.id);
                }
               
                
                $f7.dialog.close();
            } else {
                console.log(res.statusText);
                $f7.dialog.close();
            }
            
        }

        $on('pageInit', () => {
            console.log(props);
            const { id, title } = props;
            if (title) pageTitle = title;
            getAlbumItems(id);
        });
        $on('pageAfterOut', () => {
            // page has left the view
        });

        // component function must return render function
        return $render;
    }
</script>