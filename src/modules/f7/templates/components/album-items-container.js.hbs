import { LitElement, html, css } from 'https://unpkg.com/lit@latest?module';

class albumItemsContainer extends LitElement {
    static properties = {
        id: { type: String },
        title: { type: String },
    };
    static styles = css`
    `;

    connectedCallback() {
        super.connectedCallback();
        const requiredProps = ['id', 'title'];

        for (const prop of requiredProps) 
            if (this[prop] === undefined || this[prop] === null) 
                throw new Error(`<album-items-container> requiere la propiedad "${prop}"`);
    }
    createRenderRoot() {
        return this; // renderizar en Light DOM (hereda estilos externos)
    }
    render() {
        return html`
         <details class="group" data-title="${this.title}" open>
            <summary>${this.title}</summary>
            <div class="grid" id="ai-grid-${this.id}">
            </div>
        </details>
        `;
    }
}
if (!customElements.get('album-items-container')) {
    customElements.define('album-items-container', albumItemsContainer);
}
