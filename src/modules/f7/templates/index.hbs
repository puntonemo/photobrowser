<!DOCTYPE html>
<html lang="es" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Framework 7</title>
    <link rel="stylesheet" href="https://cdn.framework7.io/packages/core/framework7-bundle.min.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
    </style>
</head>

<body>
    <!-- App root element -->
    <div id="app">
        <!-- Your main view, should have "view-main" class -->
        <div class="view view-main">
            <div class="page-content">
                <!-- Initial Page, "data-name" contains page name -->
                <div data-name="home" class="page">
                    <!-- Top Navbar -->
                    <div class="navbar">
                        <div class="navbar-bg"></div>
                        <div class="navbar-inner">
                            <div class="title">Framework7 App</div>
                        </div>
                    </div>

                    <!-- Scrollable page content -->
                    <div class="page-content">
                        <div class="block margin-top">
                            <p>Lorem Ipsum Dolor Amet ...</p>
                            <div class="grid grid-cols-1 medium-grid-cols-3 grid-gap">
                                <div><a href="/signin" class="button button-fill">Iniciar sesión</a></div>
                                <div><a href="/albums" class="button button-fill">Albums</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function docReady(fn) {
            // see if DOM is already available
            if (document.readyState === "complete" || document.readyState === "interactive") {
                // call on next available tick
                setTimeout(fn, 1);
            } else {
                document.addEventListener("DOMContentLoaded", fn);
            }
        }
        async function loadComponent(container, component, attributes) {
            if (!customElements.get(component))
                await import(`{{config.path}}/components/${component}.js`); // usa ruta relativa al host

            const el = document.createElement(component);
            
            for (const entry of Object.entries(attributes)) 
                el[entry[0]] = entry[1];
            
            container.appendChild(el);
            return el;
        
        }
        async function getProfile() {
            app.f7.dialog.preloader();
            const res = await fetch('/api/auth/profile');
            if (res.ok) {
                const response = await res.json();
                console.log(response);
            } else {
                console.log(res.statusText);
            }
            app.f7.dialog.close();
        }
        docReady(function () {
            // DOM is loaded and ready for manipulation here
            console.log('hello f7');
            

            const routes = [
                {
                    path: '/',
                    url: '{{config.path}}',
                    master: true
                },
                {
                    name: 'signin',
                    path: '/signin',
                    transition: 'f7-push',
                    componentUrl: '{{config.path}}/signin',
                },
                {
                    name: 'albums',
                    path: '/albums',
                    transition: 'f7-push',
                    componentUrl: '{{config.path}}/albums',
                },
                {
                    name: 'albumItems',
                    path: '/albumItems/:id',
                    transition: 'f7-push',
                    componentUrl: '{{config.path}}/albumItems',
                },
                {
                    name: 'browse',
                    path: '/browse/:id',
                    transition: 'f7-parallax',
                    componentUrl: '{{config.path}}/browse',
                },

            ];
            var app = new Framework7({
                // App root element
                el: '#app',
                theme: 'auto',
                pushState: true,
                view: {
                    browserHistory: true
                },
                // App Name
                name: 'My App',
                // Enable swipe panel
                panel: {
                    swipe: true,
                },
                routes
            });
            var mainView = app.views.create('.view-main');
            getProfile();
        });
    </script>
    <script src="https://cdn.framework7.io/packages/core/framework7-bundle.min.js"></script>
</body>

</html>