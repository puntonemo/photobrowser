<template>
    <div class="page">
        <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner sliding">
                <div class="left">
                    <a class="link back">
                        <i class="icon icon-back"></i>
                        <span class="if-not-md">Back</span>
                    </a>
                </div>
                <div class="title">${pageTitle}</div>
            </div>
        </div>
        <div class="page-content">
            <div class="block margin-top container">

            </div>
        </div>
    </div>
        
</template>
<!-- component styles -->
<style>

</style>
<!-- rest of component logic -->
<script>
    async function loadComponent(container, component, attributes) {
        if (!customElements.get(component))
            await import(`{{config.path}}/components/${component}.js`); // usa ruta relativa al host

        const el = document.createElement(component);
        for (const entry of Object.entries(attributes)) 
            el.setAttribute(entry[0], entry[1]);
        
        container.appendChild(el);
    
    }
    async function getAlbums() {
        
        const res = await fetch('/api/pb/albums');
        if (res.ok) {
            const response = await res.json();
            const container = document.querySelector('.container');
            container.innerHTML = ''; // Limpia antes de renderizar

            for (const album of response) {
                const attributes = {
                    'id': album.id,
                    'title': album.title,
                    'description': album.description,
                    'role': album.role,
                    'createdAt': album.createdAt,
                }
                console.log(album);
                await loadComponent(container, 'album-card', attributes);
            }
        } else {
            console.log(res.statusText);
        }
    }

    // script must return/export component function
    export default (props, { $f7, $on, $f7router }) => {
        const pageTitle = "Mis álbumes"
        $on('pageInit', () => {
            getAlbums();
        });
        $on('pageAfterOut', () => {
            // page has left the view
        });

        // component function must return render function
        return $render;
    }
</script>