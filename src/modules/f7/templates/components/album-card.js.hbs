import { LitElement, html, css } from 'https://unpkg.com/lit@latest?module';

export class AlbumCard extends LitElement {
  static properties = {
    id: { type: String },
    title: { type: String },
    description: { type: String },
    role: { type: String },
    createdAt: { type: String },
    openAlbum: { type: Function },
  };

  static styles = css`

    .title {
      font-weight: bold;
      font-size: 1.2em;
    }
    .demo-card-header-pic .card-header {
      height: 40vw;
      background-size: cover;
      background-position: center;
      color: #fff;
    }
    .md .demo-card-header-pic .card-header {
      margin: 0 16px 16px;
      border-radius: 16px;
      position: relative;
      top: 16px;
    }
    .demo-card-header-pic .card-content-padding .date {
      color: #8e8e93;
    }
  `;
  connectedCallback() {
    super.connectedCallback();
    const requiredProps = ['id'];
    for (const prop of requiredProps) {
      if (this[prop] === undefined || this[prop] === null) {
        throw new Error(`<album-card> requiere la propiedad "${prop}"`);
      }
    }
  }
  createRenderRoot() {
    return this; // ✅ renderiza en Light DOM (hereda estilos externos)
  }
  render() {
    return html`
      <div class="card demo-card-header-pic" @click=${() => this.openAlbum?.(this.id)}>
        <div style="background-image:url(https://cdn.framework7.io/placeholder/people-1000x600-${this.id}.jpg)" valign="bottom" class="card-header">${this.title}</div>
        <div class="card-content card-content-padding">
          <p class="date">${this.role} · ${new Date(this.createdAt).toLocaleString()}</p>
          <p>${this.description}</p>
        </div>
        <div class="card-footer">
          <a class="button button-fill">Open</a>
          <a class="button">Like</a>
        </div>
      </div>
    `;
  }
}
if (!customElements.get('album-card')) {
  customElements.define('album-card', AlbumCard);
}
